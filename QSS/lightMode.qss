/* ==========================================================================
   MOXIE — LIGHT MODE (7-color palette)
   bg #D8CBC7 · surface #C1AEA8 · card #F5F0EE · brand #2D1A3E
   accent #3D4BA8 · muted #BFAFB3 · alert #C0392B
   Square corners everywhere; only the search pill is rounded (22px).
   ========================================================================== */
QMainWindow, #RegisterScroll, #RegisterScroll > QWidget#qt_scrollarea_viewport,
#RegisterScrollContent, #HomeScrollArea, #HomeScrollArea > QWidget#qt_scrollarea_viewport,
#HomeScrollContent, #FAQPage, #FAQScrollArea, #FAQScrollArea > QWidget#qt_scrollarea_viewport,
#FAQScrollContent, #VolunteerPage, #VolunteerScroll, #VolunteerScroll > QWidget#qt_scrollarea_viewport,
#VolunteerGridContainer, #VolunteerListContainer, #VolunteerContentStack,
#VolunteerEmptyWrap, #FeaturesSection, #OpportunitiesSection,
#MatchPage, #ExportDialog, #ClusterMultiSelect { background-color: #D8CBC7; border: none; }

/* ── Nav / surfaces ─────────────────────────────────────────────── */
#NavBar, #BottomBar, #VolunteerHeader, #FilterBar, #SearchBar {
    background-color: #C1AEA8;
    border-bottom: 1px solid #BFAFB3;
    color: #2D1A3E;
}
#BottomBar { border-top: 1px solid #BFAFB3; border-bottom: none; }

#NavLogo { color: #F5F0EE; font-size: 18px; font-weight: bold; }
#HeroLogo { font-size: 50px; }
#SloganText { font-size: 20px; color: #2D1A3E; }

/* ── Cards / dialogs / menus ─────────────────────────────────────── */
#RegisterCard, #LoginCard, #EventDetailsDialog, #EventCard, #EventCardMoxie,
#FeatureCard, #FAQItem, #MatchCard, #ExportSection, QMenu,
QComboBox QAbstractItemView, QListWidget#SearchSuggestions,
QDialog#ChatHistoryDialog, QListWidget#ChatHistoryList, QDialog {
    background-color: #F5F0EE;
    border: 1px solid #BFAFB3;
    border-radius: 0px;
    color: #2D1A3E;
}
#RegisterCard, #FeatureCard, #EventDetailsDialog { border-top: 4px solid #3D4BA8; }
#EventCardMoxie { border: 2px solid #BFAFB3; }
#EventCard:hover, #EventCardMoxie:hover { border-color: #3D4BA8; }
#FAQItem { border-left: 4px solid #3D4BA8; }

/* ── Form controls ───────────────────────────────────────────────── */
QLineEdit, QDateEdit, QComboBox, #FilterSearchInput, #FilterLocationInput,
#FilterCombo, #FilterDate, #FAQSearchInput {
    background-color: #F5F0EE;
    border: 1px solid #BFAFB3;
    border-radius: 0px;
    padding: 11px 14px;
    font-size: 14px;
    color: #2D1A3E;
    min-height: 18px;
    selection-background-color: #2D1A3E;
    selection-color: #F5F0EE;
}
QLineEdit:focus, QDateEdit:focus, QComboBox:focus,
#FilterSearchInput:focus, #FilterLocationInput:focus,
#FilterCombo:focus, #FilterDate:focus, #FAQSearchInput:focus {
    border: 2px solid #3D4BA8;
    padding: 10px 13px;
}
QLineEdit QToolButton { border: none; background: transparent; color: #BFAFB3; padding: 0 6px; }
QLineEdit QToolButton:hover { color: #3D4BA8; }
QComboBox::drop-down { border: none; padding-right: 10px; }

/* ── Buttons ─────────────────────────────────────────────────────── */
QPushButton { background: transparent; color: #2D1A3E; border: none;
              padding: 8px 16px; font-size: 14px; border-radius: 0px; }
QPushButton:hover { background-color: rgba(45,26,62,0.10); }
QPushButton:focus { border: 2px solid #3D4BA8; padding: 6px 14px; }
QPushButton::menu-indicator { image: none; width: 0; }

#PrimaryBtn, #VolunteerEmptyBtn, #SearchBtn, #HeroLearnBtn, #EventLinkBtn {
    background-color: #2D1A3E; color: #F5F0EE;
    font-weight: bold; border: none; padding: 14px;
}
#PrimaryBtn:hover, #VolunteerEmptyBtn:hover, #HeroLearnBtn:hover,
#SearchBtn:hover, #EventLinkBtn:hover { background-color: #3D4BA8; }
#PrimaryBtn:focus, #VolunteerEmptyBtn:focus, #SearchBtn:focus,
#EventLinkBtn:focus { border: 2px solid #F5F0EE; padding: 12px; }

#SecondaryBtn, #DetailsCloseBtn, #FilterClearBtn, #FilterMoreBtn, #BackBtn {
    background: transparent; color: #BFAFB3;
    border: 1px solid #BFAFB3; padding: 8px 14px; font-size: 13px;
}
#SecondaryBtn:hover, #DetailsCloseBtn:hover, #FilterClearBtn:hover,
#FilterMoreBtn:hover, #BackBtn:hover {
    color: #3D4BA8; border-color: #3D4BA8;
}
#FilterMoreBtn:checked { color: #2D1A3E; border-color: #3D4BA8; }

#EventRsvpBtn, #SearchBtn, #VolunteerEmptyBtn {
    background-color: #3D4BA8; color: #F5F0EE;
    min-height: 15px;
}

#EventRsvpBtn:hover { background-color: #2D1A3E; }
#EventRsvpBtn:disabled, #EventLinkBtn:disabled, #SearchBtn:disabled {
    background-color: #BFAFB3; color: #F5F0EE;
}

#ViewToggleBtn {
    background-color: #F5F0EE; color: #2D1A3E;
    border: 1px solid #BFAFB3; padding: 8px 16px;
    font-size: 13px; font-weight: bold;
}
#ViewToggleBtn:checked { background-color: #2D1A3E; color: #F5F0EE; border-color: #2D1A3E; }
#ViewToggleBtn:hover { border-color: #3D4BA8; }

/* ── Search bar pill (only rounded element) ─────────────────────── */
#SearchInput, #SearchCategoryCombo {
    background-color: #F5F0EE; border: 1px solid #BFAFB3;
    border-radius: 22px; padding: 10px 16px; font-size: 13px;
    color: #2D1A3E; min-height: 18px;
}
#SearchInput:focus, #SearchCategoryCombo:focus {
    border: 2px solid #3D4BA8; padding: 9px 15px;
}
#SearchCategoryCombo QAbstractItemView {
    background-color: #F5F0EE; border: 1px solid #BFAFB3;
    border-radius: 12px; color: #2D1A3E;
    selection-background-color: #2D1A3E; selection-color: #F5F0EE;
}

/* ── Badges / typography ─────────────────────────────────────────── */
#FormTitle, #FAQTitle, #VolunteerTitle, #SectionTitle, #OpportunityRowTitle,
#HeroMissionTitle {
    font-family: "Playfair Display", "Georgia", "Times New Roman", serif;
    font-weight: bold; color: #2D1A3E;
}
#FormTitle { font-size: 30px; } #FAQTitle { font-size: 26px; }
#SectionTitle { font-size: 26px; } #VolunteerTitle { font-size: 24px; padding-left: 10px; }
#OpportunityRowTitle { font-size: 16px; }
#HeroMissionTitle { font-size: 90px; font-weight: 900; letter-spacing: -2px; }

#FormSubtitle, #SloganText, #VolunteerResultsCount, #EventOrg,
#VolunteerEmpty, #OpportunityEmpty, #FAQNoResults, #EventMetaKey {
    color: #BFAFB3; font-size: 13px;
}
#VolunteerEmpty, #OpportunityEmpty, #FAQNoResults { font-style: italic; font-size: 15px; }
#VolunteerResultsCount { font-style: italic; }

#FieldLabel, #FilterLabel { color: #BFAFB3; font-size: 12px; font-weight: bold; }
#EventTitle { font-size: 15px; font-weight: bold; color: #2D1A3E; }
#EventTitleList { font-size: 17px; font-weight: bold; color: #2D1A3E; }
#EventDescription, #DetailsDescription { font-size: 12px; color: #2D1A3E; }
#EventMetaValue { font-size: 12px; color: #2D1A3E; font-weight: bold; }

#EventCategoryBadge, #EventStatusBadge, #EventSourceMoxie {
    background-color: #3D4BA8; color: #F5F0EE;
    font-size: 10px; font-weight: 700; padding: 4px 10px;
    border-radius: 9px;
}
#EventStatusBadge, #EventSourceMoxie { background-color: #2D1A3E; }
#EventLocationBadge, #EventSourceExternal {
    background: transparent; color: #BFAFB3;
    border: 1px solid #BFAFB3; padding: 3px 8px;
    font-size: 10px; font-weight: 700; border-radius: 9px;
}

/* ── Open Details (consistent, opaque) + Bookmark ────────────────── */
#EventDetailsBtn {
    background-color: #3D4BA8; color: #F5F0EE;
    border: none; border-radius: 0px;
    padding: 6px 15px; font-size: 12px; font-weight: 700;
    min-height: 15px;
}
#EventDetailsBtn:hover  { background-color: #2D1A3E; }
#EventDetailsBtn:pressed{ background-color: #2D1A3E; }
#EventDetailsBtn:focus  { border: 2px solid #F5F0EE; }

#EventBookmarkBtn {
    background-color: #F5F0EE; color: #BFAFB3;
    border: 1px solid #BFAFB3; font-size: 18px;
    padding: 0; border-radius: 0px;
}
#EventBookmarkBtn:hover  { color: #3D4BA8; border-color: #3D4BA8; }
#EventBookmarkBtnOn {
    background-color: #3D4BA8; color: #F5F0EE;
    border: none; font-size: 18px; padding: 0; border-radius: 0px;
}
#EventBookmarkBtnOn:hover { background-color: #2D1A3E; }

/* ── Bookmark / Match / Cluster chips ────────────────────────────── */
#MatchStepTitle { font-size: 20px; font-weight: bold; color: #2D1A3E; }
#MatchChip, #ClusterChip {
    background-color: #F5F0EE; color: #2D1A3E;
    border: 1px solid #BFAFB3; padding: 8px 14px;
    font-size: 13px; border-radius: 0px;
}
#MatchChip:hover, #ClusterChip:hover { border-color: #3D4BA8; }
#MatchChip:checked, #ClusterChip:checked,
#MatchChipChecked, #ClusterChipChecked {
    background-color: #2D1A3E; color: #F5F0EE; border-color: #2D1A3E;
}

/* ── QR / time-gated event view ──────────────────────────────────── */
#EventQrDialog { background-color: #F5F0EE; border-top: 4px solid #3D4BA8; }
#EventQrImage  { background-color: #F5F0EE; border: 1px solid #BFAFB3; }
#EventQrStatus { font-size: 14px; font-weight: bold; color: #2D1A3E; }
#EventQrWindow { font-size: 12px; color: #BFAFB3; }

/* ── Nav group dropdowns ─────────────────────────────────────────── */
#NavGroupBtn { color: #2D1A3E; padding: 8px 14px; font-weight: 600; }
#NavGroupBtn:hover, #NavGroupBtn:checked { background-color: rgba(45,26,62,0.10); }

/* ── Scrollbars ──────────────────────────────────────────────────── */
QScrollBar:vertical { background: transparent; width: 10px; margin: 0; }
QScrollBar::handle:vertical { background: #BFAFB3; min-height: 32px; }
QScrollBar::handle:vertical:hover { background: #2D1A3E; }
QScrollBar:horizontal { background: transparent; height: 10px; margin: 0; }
QScrollBar::handle:horizontal { background: #BFAFB3; min-width: 32px; }
QScrollBar::handle:horizontal:hover { background: #2D1A3E; }
QScrollBar::add-line, QScrollBar::sub-line { width: 0; height: 0; }
QScrollBar::add-page, QScrollBar::sub-page { background: none; }

/* ── Chat / mic ──────────────────────────────────────────────────── */
#ChatView, #ChatScrollArea, #ChatScrollArea > QWidget#qt_scrollarea_viewport,
#ChatTranscript { background: transparent; border: none; }
#ChatComposer { background-color: #F5F0EE; border: 1px solid #BFAFB3; border-radius: 24px; }
QLineEdit#ChatInput { background: transparent; border: none; color: #2D1A3E; }
QPushButton#ChatIconButton { background-color: #2D1A3E; color: #F5F0EE;
                             border: 1px solid #BFAFB3; border-radius: 20px; }
QPushButton#ChatIconButton:hover { background-color: #3D4BA8; }
QPushButton#ChatIconButton:checked { background-color: #C0392B; }
QLabel#ChatUserBubbleFirst, QLabel#ChatUserBubbleGrouped {
    background-color: #2D1A3E; color: #F5F0EE; padding: 8px 12px; font-size: 13px;
}
QLabel#ChatUserBubbleFirst {
    border-top-left-radius: 16px; border-top-right-radius: 16px;
    border-bottom-right-radius: 4px; border-bottom-left-radius: 16px;
}
QLabel#ChatUserBubbleGrouped { border-radius: 16px; }
QLabel#ChatAssistantBubbleFirst, QLabel#ChatAssistantBubbleGrouped,
QLabel#ChatTypingBubble {
    background-color: #F5F0EE; color: #2D1A3E;
    border: 1px solid #BFAFB3; padding: 8px 12px; font-size: 13px;
}
QLabel#ChatAssistantBubbleFirst, QLabel#ChatTypingBubble {
    border-top-left-radius: 4px; border-top-right-radius: 16px;
    border-bottom-right-radius: 16px; border-bottom-left-radius: 16px;
}
QLabel#ChatAssistantBubbleGrouped { border-radius: 16px; }
QLabel#ChatTypingBubble { color: #BFAFB3; padding: 8px 14px; font-size: 11px; }
QLabel#ChatAvatar { background-color: #2D1A3E; color: #F5F0EE;
                    border-radius: 14px; font-size: 13px; font-weight: bold; }
QLabel#ChatTimestamp, QLabel#ChatDateLabel { color: #BFAFB3; padding: 0 6px; }
QLabel#ChatTimestamp { font-size: 10px; }
QLabel#ChatDateLabel { font-size: 11px; font-weight: 600; }
QFrame#ChatDateRule { color: #BFAFB3; }

QPushButton#GlobalMic { background: #2D1A3E; color: #F5F0EE;
                        border: none; border-radius: 22px; font-size: 18px; }
QPushButton#GlobalMic:hover { background: #3D4BA8; }
QPushButton#GlobalMic[listening="true"] { background: #C0392B; font-size: 20px; }
/* ==========================================================================
   FAQ — Bolt-inspired redesign (light)
   ========================================================================== */
#FAQPage,
#FAQScrollArea,
#FAQScrollArea > QWidget#qt_scrollarea_viewport,
#FAQScrollContent {
    background-color: #D8CBC7;
    border: none;
}

#FAQTitle {
    font-family: "Playfair Display", "Georgia", "Times New Roman", serif;
    font-size: 44px;
    font-weight: 900;
    color: #2D1A3E;
    letter-spacing: -0.5px;
    padding: 8px 0 6px 0;
}

#FAQSubtitle {
    font-size: 14px;
    color: #4E3C5C;
    padding: 0 60px;
}

#FAQSearchInput {
    background-color: #F5F0EE;
    border: 1px solid #BFAFB3;
    border-radius: 22px;
    padding: 12px 20px;
    font-size: 13px;
    color: #2D1A3E;
    min-height: 18px;
    selection-background-color: #2D1A3E;
    selection-color: #F5F0EE;
}
#FAQSearchInput:focus {
    border: 2px solid #3D4BA8;
    padding: 11px 19px;
    background-color: #FFFFFF;
}

#FAQCatPill {
    background-color: transparent;
    color: #4E3C5C;
    border: 1px solid #BFAFB3;
    border-radius: 18px;
    padding: 6px 18px;
    font-size: 12px;
    font-weight: 600;
}
#FAQCatPill:hover {
    border-color: #3D4BA8;
    color: #2D1A3E;
}
#FAQCatPill:checked {
    background-color: #2D1A3E;
    color: #F5F0EE;
    border-color: #2D1A3E;
}
#FAQCatPill:focus {
    border: 2px solid #3D4BA8;
}

#FAQCategoryHeading {
    font-family: "Segoe UI", "SF Pro Display", Arial, sans-serif;
    font-size: 22px;
    font-weight: 800;
    color: #2D1A3E;
    padding: 20px 0 4px 0;
    background: transparent;
    border: none;
}

#FAQItem {
    background-color: #F5F0EE;
    border: 1px solid #BFAFB3;
    border-radius: 12px;
    min-height: 60px;
}
#FAQItem:hover {
    border-color: #3D4BA8;
}

#FAQHeader {
    background: transparent;
    border: none;
}

#FAQQuestion {
    font-size: 14px;
    font-weight: 700;
    color: #2D1A3E;
    padding: 6px 0;
    background: transparent;
    border: none;
}

#FAQAnswer {
    font-size: 13px;
    color: #4E3C5C;
    padding: 14px 0 2px 0;
    margin-top: 8px;
    border-top: 1px solid #BFAFB3;
    background: transparent;
}

#FAQToggleBtn {
    background-color: #2D1A3E;
    color: #F5F0EE;
    border: none;
    border-radius: 16px;
    font-size: 20px;
    font-weight: 600;
    padding: 0;
    min-width: 32px;
    max-width: 32px;
    min-height: 32px;
    max-height: 32px;
}
#FAQToggleBtn:hover {
    background-color: #3D4BA8;
}
#FAQToggleBtn[expanded="true"] {
    background-color: #3D4BA8;
}
#FAQToggleBtn:focus {
    border: 2px solid #3D4BA8;
}

#FAQNoResults {
    color: #6B5B77;
    font-size: 14px;
    font-style: italic;
    padding: 40px 0;
}
/* ==========================================================================
   VOLUNTEER PAGE — sidebar + redesigned cards (light)
   ========================================================================== */

#EventMainArea {
    background-color: #D8CBC7;
    border: none;
}

/* ── Sidebar ─────────────────────────────────────────────────────── */
#FilterSidebar {
    background-color: #C1AEA8;
    border-right: 1px solid #BFAFB3;
}

#FilterSidebarScroll,
#FilterSidebarScroll > QWidget#qt_scrollarea_viewport,
#FilterSidebarContent {
    background-color: #C1AEA8;
    border: none;
}

#FilterSidebarHeading {
    font-size: 11px;
    font-weight: 800;
    color: #4E3C5C;
    letter-spacing: 1.2px;
    padding-top: 6px;
    background: transparent;
}

#FilterSidebarInput {
    background-color: #F5F0EE;
    border: 1px solid #BFAFB3;
    border-radius: 10px;
    padding: 9px 12px;
    font-size: 13px;
    color: #2D1A3E;
    min-height: 18px;
}
#FilterSidebarInput:focus {
    border: 2px solid #3D4BA8;
    padding: 8px 11px;
    background-color: #FFFFFF;
}
#FilterSidebarInput::drop-down {
    border: none;
    padding-right: 8px;
}

#FilterSidebarRadio,
#FilterSidebarCheck {
    font-size: 13px;
    color: #2D1A3E;
    background: transparent;
    padding: 3px 0;
    spacing: 8px;
}
#FilterSidebarRadio::indicator,
#FilterSidebarCheck::indicator {
    width: 16px;
    height: 16px;
    border: 1px solid #BFAFB3;
    background-color: #F5F0EE;
}
#FilterSidebarRadio::indicator {
    border-radius: 8px;
}
#FilterSidebarCheck::indicator {
    border-radius: 4px;
}
#FilterSidebarRadio::indicator:hover,
#FilterSidebarCheck::indicator:hover {
    border-color: #3D4BA8;
}
#FilterSidebarRadio::indicator:checked,
#FilterSidebarCheck::indicator:checked {
    background-color: #2D1A3E;
    border-color: #2D1A3E;
}

#FilterSidebarClear {
    background-color: #2D1A3E;
    color: #F5F0EE;
    border: none;
    padding: 12px 16px;
    font-size: 13px;
    font-weight: 700;
    margin: 12px;
    border-radius: 10px;
}
#FilterSidebarClear:hover {
    background-color: #3D4BA8;
}

/* ── Event card body ─────────────────────────────────────────────── */
#EventCardBody {
    background: transparent;
    border: none;
}

#EventClusterChip {
    background-color: #3D4BA8;
    color: #F5F0EE;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.4px;
    padding: 4px 10px;
    border-radius: 10px;
}
/* Only show chip width to fit content */
#EventClusterChip { min-width: 0; max-width: 220px; }

/* Meta label above value in card */
#EventCardMetaIcon {
    font-size: 10px;
    font-weight: 800;
    color: #BFAFB3;
    letter-spacing: 1px;
}

#EventCard {
    background-color: #F5F0EE;
    border: 1px solid #BFAFB3;
    border-radius: 16px;
}
#EventCard:hover { border-color: #3D4BA8; }

#EventCardMoxie {
    background-color: #F5F0EE;
    border: 1px solid #3D4BA8;
    border-radius: 16px;
}
#EventCardMoxie:hover { border-color: #2D1A3E; }

#EventThumb {
    background-color: #F1ECEE;
    color: #7A6F73;
    font-size: 12px;
    border-top-left-radius: 16px;
    border-top-right-radius: 16px;
}

#EventTitle {
    font-size: 16px;
    font-weight: 800;
    color: #2D1A3E;
}

#EventTitleList {
    font-size: 18px;
    font-weight: 800;
    color: #2D1A3E;
}

#EventOrg {
    font-size: 12px;
    color: #6B5B77;
}

#EventDescription {
    font-size: 12px;
    color: #4E3C5C;
}

#EventMetaValue {
    font-size: 12px;
    color: #2D1A3E;
    font-weight: 600;
}

#EventMetaKey {
    font-size: 10px;
    color: #BFAFB3;
    font-weight: 700;
    letter-spacing: 1px;
}

/* Action buttons inside cards */
#EventDetailsBtn {
    background-color: #3D4BA8;
    color: #F5F0EE;
    border: none;
    border-radius: 10px;
    padding: 10px 16px;
    font-size: 12px;
    font-weight: 700;
}
#EventDetailsBtn:hover  { background-color: #2D1A3E; }
#EventDetailsBtn:pressed{ background-color: #2D1A3E; }

#EventRsvpBtn {
    background-color: #2D1A3E;
    color: #F5F0EE;
    border: none;
    border-radius: 10px;
    padding: 10px 16px;
    font-size: 12px;
    font-weight: 700;
}
#EventRsvpBtn:hover { background-color: #3D4BA8; }
#EventRsvpBtn:disabled {
    background-color: #BFAFB3; color: #F5F0EE;
}

#EventLinkBtn {
    background-color: #F5F0EE;
    color: #2D1A3E;
    border: 1px solid #BFAFB3;
    border-radius: 10px;
    padding: 10px 16px;
    font-size: 12px;
    font-weight: 700;
}
#EventLinkBtn:hover { border-color: #3D4BA8; color: #3D4BA8; }
#EventLinkBtn:disabled { color: #BFAFB3; }

#EventBookmarkBtn {
    background-color: #F5F0EE;
    color: #BFAFB3;
    border: 1px solid #BFAFB3;
    border-radius: 10px;
    font-size: 18px;
    padding: 0;
}
#EventBookmarkBtn:hover { color: #3D4BA8; border-color: #3D4BA8; }
#EventBookmarkBtnOn {
    background-color: #3D4BA8;
    color: #F5F0EE;
    border: none;
    border-radius: 10px;
    font-size: 18px;
    padding: 0;
}

#EventSourceMoxie {
    background-color: #2D1A3E; color: #F5F0EE;
    font-size: 10px; font-weight: 700;
    padding: 4px 10px; border-radius: 10px;
}
#EventSourceExternal {
    background-color: rgba(245, 240, 238, 0.9);
    color: #4E3C5C;
    border: 1px solid #BFAFB3;
    font-size: 10px; font-weight: 700;
    padding: 3px 9px; border-radius: 10px;
}

#VolunteerResultsCount {
    font-size: 12px;
    color: #6B5B77;
    letter-spacing: 0.4px;
}
/* ==========================================================================
   HERO — editorial split-panel
   ========================================================================== */
#HeroSection {
    background-color: #D8CBC7;
}

#HeroLeftPanel {
    background-color: #D8CBC7;
}

#HeroRightPanel {
    background-color: #F5F0EE;
}

#HeroBottomBar {
    background-color: #2D1A3E;
}

#HeroWordmark {
    padding: 0;
    margin: 0;
}

#HeroHeadline {
    font-family: "Playfair Display", "Georgia", "Times New Roman", serif;
    font-size: 44px;
    font-weight: 700;
    color: #2D1A3E;
    line-height: 1.15em;
}

#HeroSub {
    font-size: 15px;
    color: #4E3C5C;
    line-height: 1.55em;
}

#HeroPhoto {
    background-color: #F5F0EE;
    border: none;
}