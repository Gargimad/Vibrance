/* ==========================================================================
   MOXIE — DARK MODE (7-color palette)
   bg #1E1626 · surface #2A1F33 · card #2E2238 · brand #B39CDB
   accent #7B8BE0 · muted #4A3A54 · alert #E74C3C
   ========================================================================== */
QMainWindow, #RegisterScroll, #RegisterScroll > QWidget#qt_scrollarea_viewport,
#RegisterScrollContent, #HomeScrollArea, #HomeScrollArea > QWidget#qt_scrollarea_viewport,
#HomeScrollContent, #FAQPage, #FAQScrollArea, #FAQScrollArea > QWidget#qt_scrollarea_viewport,
#FAQScrollContent, #VolunteerPage, #VolunteerScroll, #VolunteerScroll > QWidget#qt_scrollarea_viewport,
#VolunteerGridContainer, #VolunteerListContainer, #VolunteerContentStack,
#VolunteerEmptyWrap, #FeaturesSection, #OpportunitiesSection,
#MatchPage, #ExportDialog, #ClusterMultiSelect, QMessageBox,
QWidget#LoginCard, QDialog, #VolunteerDashboard { background-color: #1E1626; border: none; }
#VolunteerDashboard QLabel { color: #B39CDB; }

/* ── Nav / surfaces ─────────────────────────────────────────────── */
#NavBar, #BottomBar, #VolunteerHeader { background-color: #2A1F33; color: #B39CDB; }
#NavBar { border-bottom: 1px solid rgba(179,156,219,0.10); }
#BottomBar { border-top: 1px solid #4A3A54; border-bottom: none; }
#FilterBar, #SearchBar { background-color: #2E2238; border-bottom: 1px solid #4A3A54; }
#NavLogo { color: #B39CDB; font-size: 18px; font-weight: bold; }
#SloganText { font-size: 20px; color: #B39CDB; }

/* ── Cards / dialogs / menus ─────────────────────────────────────── */
#RegisterCard, #LoginCard, #EventDetailsDialog, #EventCard, #EventCardMoxie,
#FeatureCard, #FAQItem, #MatchCard, #ExportSection, QMenu,
QComboBox QAbstractItemView, QListWidget#SearchSuggestions,
QDialog#ChatHistoryDialog, QListWidget#ChatHistoryList, QDialog,
#VolunteerDashboard #EventCard {
    background-color: #2E2238;
    border: 1px solid #4A3A54;
    border-radius: 0px;
    color: #B39CDB;
}
#RegisterCard, #FeatureCard, #EventDetailsDialog,
#VolunteerDashboard #EventCard { border-top: 4px solid #7B8BE0; }
#EventCardMoxie { border: 2px solid #7B8BE0; }
#EventCard:hover, #EventCardMoxie:hover { border-color: #7B8BE0; }
#FAQItem { border-left: 4px solid #7B8BE0; }

/* ── Form controls ───────────────────────────────────────────────── */
QLineEdit, QDateEdit, QComboBox, #FilterSearchInput, #FilterLocationInput,
#FilterCombo, #FilterDate, #FAQSearchInput {
    background-color: #2E2238;
    border: 1px solid #4A3A54;
    border-radius: 0px;
    padding: 11px 14px;
    font-size: 14px;
    color: #B39CDB;
    min-height: 18px;
    selection-background-color: #B39CDB;
    selection-color: #1E1626;
}
QLineEdit:focus, QDateEdit:focus, QComboBox:focus,
#FilterSearchInput:focus, #FilterLocationInput:focus,
#FilterCombo:focus, #FilterDate:focus, #FAQSearchInput:focus {
    border: 2px solid #7B8BE0;
    padding: 10px 13px;
}
QLineEdit QToolButton { border: none; background: transparent; color: #4A3A54; padding: 0 6px; }
QLineEdit QToolButton:hover { color: #7B8BE0; }
QComboBox::drop-down { border: none; padding-right: 10px; }

/* ── Buttons ─────────────────────────────────────────────────────── */
QPushButton { background: transparent; color: #B39CDB; border: none;
              padding: 8px 16px; font-size: 14px; border-radius: 0px; }
QPushButton:hover { background-color: rgba(179,156,219,0.12); }
QPushButton:focus { border: 2px solid #7B8BE0; padding: 6px 14px; }
QPushButton::menu-indicator { image: none; width: 0; }

#PrimaryBtn, #VolunteerEmptyBtn, #SearchBtn, #HeroLearnBtn, #EventLinkBtn {
    background-color: #B39CDB; color: #1E1626;
    font-weight: bold; border: none; padding: 14px;
}
#PrimaryBtn:hover, #VolunteerEmptyBtn:hover, #HeroLearnBtn:hover,
#SearchBtn:hover, #EventLinkBtn:hover { background-color: #7B8BE0; }
#PrimaryBtn:focus, #VolunteerEmptyBtn:focus, #SearchBtn:focus,
#EventLinkBtn:focus { border: 2px solid #B39CDB; padding: 12px; }

#SecondaryBtn, #DetailsCloseBtn, #FilterClearBtn, #FilterMoreBtn, #BackBtn {
    background: transparent; color: #4A3A54;
    border: 1px solid #4A3A54; padding: 8px 14px; font-size: 13px;
}
#SecondaryBtn:hover, #DetailsCloseBtn:hover, #FilterClearBtn:hover,
#FilterMoreBtn:hover, #BackBtn:hover { color: #7B8BE0; border-color: #7B8BE0; }
#FilterMoreBtn:checked { color: #B39CDB; border-color: #7B8BE0; }

#EventRsvpBtn { background-color: #7B8BE0; color: #F5F0EE; }
#EventRsvpBtn:hover { background-color: #B39CDB; color: #1E1626; }
#EventRsvpBtn:disabled, #EventLinkBtn:disabled, #SearchBtn:disabled {
    background-color: #4A3A54; color: #2E2238;
}

#ViewToggleBtn { background-color: #2E2238; color: #B39CDB;
                 border: 1px solid #4A3A54; padding: 8px 16px;
                 font-size: 13px; font-weight: bold; }
#ViewToggleBtn:checked { background-color: #B39CDB; color: #1E1626; border-color: #B39CDB; }
#ViewToggleBtn:hover { border-color: #7B8BE0; }

/* ── Search pill ─────────────────────────────────────────────────── */
#SearchInput, #SearchCategoryCombo {
    background-color: #2E2238; border: 1px solid #4A3A54;
    border-radius: 22px; padding: 10px 16px; font-size: 13px;
    color: #B39CDB; min-height: 18px;
}
#SearchInput:focus, #SearchCategoryCombo:focus {
    border: 2px solid #7B8BE0; padding: 9px 15px;
}
#SearchCategoryCombo QAbstractItemView {
    background-color: #2E2238; border: 1px solid #4A3A54;
    border-radius: 12px; color: #B39CDB;
    selection-background-color: #B39CDB; selection-color: #1E1626;
}

/* ── Badges / typography ─────────────────────────────────────────── */
#FormTitle, #FAQTitle, #VolunteerTitle, #SectionTitle, #OpportunityRowTitle,
#HeroMissionTitle, #VolunteerDashboard #EventTitleList {
    font-family: "Playfair Display", "Georgia", "Times New Roman", serif;
    font-weight: bold; color: #B39CDB;
}
#FormTitle { font-size: 30px; } #FAQTitle { font-size: 26px; }
#SectionTitle { font-size: 26px; } #VolunteerTitle { font-size: 24px; padding-left: 10px; }
#OpportunityRowTitle { font-size: 16px; }
#HeroMissionTitle { font-size: 84px; font-weight: 900; letter-spacing: -2px; }

#FormSubtitle, #SloganText, #VolunteerResultsCount, #EventOrg,
#VolunteerEmpty, #OpportunityEmpty, #FAQNoResults, #EventMetaKey,
#VolunteerDashboard #EventMetaValue, #VolunteerDashboard #FormSubtitle {
    color: #4A3A54; font-size: 13px;
}
#VolunteerEmpty, #OpportunityEmpty, #FAQNoResults { font-style: italic; font-size: 15px; }

#FieldLabel, #FilterLabel { color: #B39CDB; font-size: 12px; font-weight: bold; }
#EventTitle, #EventTitleList { color: #B39CDB; font-weight: bold; }
#EventTitle { font-size: 15px; } #EventTitleList { font-size: 17px; }
#EventDescription, #DetailsDescription { font-size: 12px; color: #B39CDB; }
#EventMetaValue { font-size: 12px; color: #B39CDB; font-weight: bold; }

#EventCategoryBadge, #EventStatusBadge, #EventSourceMoxie {
    background-color: #7B8BE0; color: #1E1626;
    font-size: 10px; font-weight: 700; padding: 4px 10px;
    border-radius: 9px;
}
#EventStatusBadge, #EventSourceMoxie { background-color: #B39CDB; color: #1E1626; }
#EventLocationBadge, #EventSourceExternal {
    background: transparent; color: #4A3A54;
    border: 1px solid #4A3A54; padding: 3px 8px;
    font-size: 10px; font-weight: 700; border-radius: 9px;
}

/* ── Open Details + Bookmark ─────────────────────────────────────── */
#EventDetailsBtn {
    background-color: #7B8BE0; color: #1E1626;
    border: none; border-radius: 0px;
    padding: 6px 16px; font-size: 12px; font-weight: 700;
    min-height: 34px;
}
#EventDetailsBtn:hover  { background-color: #B39CDB; }
#EventDetailsBtn:pressed{ background-color: #B39CDB; }
#EventDetailsBtn:focus  { border: 2px solid #B39CDB; }

#EventBookmarkBtn {
    background-color: #2E2238; color: #4A3A54;
    border: 1px solid #4A3A54; font-size: 18px;
    padding: 0; border-radius: 0px;
}
#EventBookmarkBtn:hover  { color: #7B8BE0; border-color: #7B8BE0; }
#EventBookmarkBtnOn {
    background-color: #7B8BE0; color: #1E1626;
    border: none; font-size: 18px; padding: 0; border-radius: 0px;
}
#EventBookmarkBtnOn:hover { background-color: #B39CDB; }

/* ── Match / clusters / QR / nav groups ─────────────────────────── */
#MatchStepTitle { font-size: 20px; font-weight: bold; color: #B39CDB; }
#MatchChip, #ClusterChip {
    background-color: #2E2238; color: #B39CDB;
    border: 1px solid #4A3A54; padding: 8px 14px;
    font-size: 13px; border-radius: 0px;
}
#MatchChip:hover, #ClusterChip:hover { border-color: #7B8BE0; }
#MatchChip:checked, #ClusterChip:checked,
#MatchChipChecked, #ClusterChipChecked {
    background-color: #B39CDB; color: #1E1626; border-color: #B39CDB;
}
#EventQrDialog { background-color: #2E2238; border-top: 4px solid #7B8BE0; }
#EventQrImage  { background-color: #2E2238; border: 1px solid #4A3A54; }
#EventQrStatus { font-size: 14px; font-weight: bold; color: #B39CDB; }
#EventQrWindow { font-size: 12px; color: #4A3A54; }
#NavGroupBtn { color: #B39CDB; padding: 8px 14px; font-weight: 600; }
#NavGroupBtn:hover, #NavGroupBtn:checked { background-color: rgba(179,156,219,0.12); }

/* ── Scrollbars ──────────────────────────────────────────────────── */
QScrollBar:vertical { background: transparent; width: 10px; margin: 0; }
QScrollBar::handle:vertical { background: #4A3A54; min-height: 32px; }
QScrollBar::handle:vertical:hover { background: #B39CDB; }
QScrollBar:horizontal { background: transparent; height: 10px; margin: 0; }
QScrollBar::handle:horizontal { background: #4A3A54; min-width: 32px; }
QScrollBar::handle:horizontal:hover { background: #B39CDB; }
QScrollBar::add-line, QScrollBar::sub-line { width: 0; height: 0; }
QScrollBar::add-page, QScrollBar::sub-page { background: none; }

/* ── Chat / mic ──────────────────────────────────────────────────── */
#ChatView, #ChatScrollArea, #ChatScrollArea > QWidget#qt_scrollarea_viewport,
#ChatTranscript { background: transparent; border: none; }
#ChatComposer { background-color: #2E2238; border: 1px solid #4A3A54; border-radius: 24px; }
QLineEdit#ChatInput { background: transparent; border: none; color: #B39CDB; }
QPushButton#ChatIconButton { background-color: #B39CDB; color: #1E1626;
                             border: 1px solid #7B8BE0; border-radius: 20px; }
QPushButton#ChatIconButton:hover { background-color: #7B8BE0; }
QPushButton#ChatIconButton:checked { background-color: #E74C3C; color: #F5F0EE; }
QLabel#ChatUserBubbleFirst, QLabel#ChatUserBubbleGrouped {
    background-color: #7B8BE0; color: #1E1626; padding: 8px 12px; font-size: 13px;
}
QLabel#ChatUserBubbleFirst {
    border-top-left-radius: 16px; border-top-right-radius: 16px;
    border-bottom-right-radius: 4px; border-bottom-left-radius: 16px;
}
QLabel#ChatUserBubbleGrouped { border-radius: 16px; }
QLabel#ChatAssistantBubbleFirst, QLabel#ChatAssistantBubbleGrouped,
QLabel#ChatTypingBubble {
    background-color: #2E2238; color: #B39CDB;
    border: 1px solid #4A3A54; padding: 8px 12px; font-size: 13px;
}
QLabel#ChatAssistantBubbleFirst, QLabel#ChatTypingBubble {
    border-top-left-radius: 4px; border-top-right-radius: 16px;
    border-bottom-right-radius: 16px; border-bottom-left-radius: 16px;
}
QLabel#ChatAssistantBubbleGrouped { border-radius: 16px; }
QLabel#ChatTypingBubble { color: #4A3A54; padding: 8px 14px; font-size: 11px; }
QLabel#ChatAvatar { background-color: #B39CDB; color: #1E1626;
                    border-radius: 14px; font-size: 13px; font-weight: bold; }
QLabel#ChatTimestamp, QLabel#ChatDateLabel { color: #4A3A54; padding: 0 6px; }
QLabel#ChatTimestamp { font-size: 10px; }
QLabel#ChatDateLabel { font-size: 11px; font-weight: 600; }
QFrame#ChatDateRule { color: #4A3A54; }

QPushButton#GlobalMic { background: #B39CDB; color: #1E1626;
                        border: none; border-radius: 22px; font-size: 18px; }
QPushButton#GlobalMic:hover { background: #7B8BE0; }
QPushButton#GlobalMic[listening="true"] { background: #E74C3C; font-size: 20px; }
/* ==========================================================================
   FAQ — Bolt-inspired redesign (dark)
   ========================================================================== */
#FAQPage,
#FAQScrollArea,
#FAQScrollArea > QWidget#qt_scrollarea_viewport,
#FAQScrollContent {
    background-color: #1E1626;
    border: none;
}

#FAQTitle {
    font-family: "Playfair Display", "Georgia", "Times New Roman", serif;
    font-size: 44px;
    font-weight: 900;
    color: #EDE6F2;
    letter-spacing: -0.5px;
    padding: 8px 0 6px 0;
}

#FAQSubtitle {
    font-size: 14px;
    color: #C7B9D4;
    padding: 0 60px;
}

#FAQSearchInput {
    background-color: #2E2238;
    border: 1px solid #4A3A54;
    border-radius: 22px;
    padding: 12px 20px;
    font-size: 13px;
    color: #EDE6F2;
    min-height: 18px;
    selection-background-color: #B39CDB;
    selection-color: #1E1626;
}
#FAQSearchInput:focus {
    border: 2px solid #7B8BE0;
    padding: 11px 19px;
    background-color: #352543;
}

#FAQCatPill {
    background-color: transparent;
    color: #C7B9D4;
    border: 1px solid #4A3A54;
    border-radius: 18px;
    padding: 6px 18px;
    font-size: 12px;
    font-weight: 600;
}
#FAQCatPill:hover {
    border-color: #7B8BE0;
    color: #EDE6F2;
}
#FAQCatPill:checked {
    background-color: #B39CDB;
    color: #1E1626;
    border-color: #B39CDB;
}
#FAQCatPill:focus {
    border: 2px solid #7B8BE0;
}

#FAQCategoryHeading {
    font-family: "Segoe UI", "SF Pro Display", Arial, sans-serif;
    font-size: 22px;
    font-weight: 800;
    color: #EDE6F2;
    padding: 20px 0 4px 0;
    background: transparent;
    border: none;
}

#FAQItem {
    background-color: #2E2238;
    border: 1px solid #4A3A54;
    border-radius: 12px;
    min-height: 60px;
}
#FAQItem:hover {
    border-color: #7B8BE0;
}

#FAQHeader {
    background: transparent;
    border: none;
}

#FAQQuestion {
    font-size: 14px;
    font-weight: 700;
    color: #EDE6F2;
    padding: 6px 0;
    background: transparent;
    border: none;
}

#FAQAnswer {
    font-size: 13px;
    color: #C7B9D4;
    padding: 14px 0 2px 0;
    margin-top: 8px;
    border-top: 1px solid #4A3A54;
    background: transparent;
}

#FAQToggleBtn {
    background-color: #B39CDB;
    color: #1E1626;
    border: none;
    border-radius: 16px;
    font-size: 20px;
    font-weight: 600;
    padding: 0;
    min-width: 32px;
    max-width: 32px;
    min-height: 32px;
    max-height: 32px;
}
#FAQToggleBtn:hover {
    background-color: #7B8BE0;
}
#FAQToggleBtn[expanded="true"] {
    background-color: #7B8BE0;
}
#FAQToggleBtn:focus {
    border: 2px solid #7B8BE0;
}

#FAQNoResults {
    color: #9C8EA9;
    font-size: 14px;
    font-style: italic;
    padding: 40px 0;
}
/* ==========================================================================
   VOLUNTEER PAGE — sidebar + redesigned cards (dark)
   ========================================================================== */

#EventMainArea {
    background-color: #1E1626;
    border: none;
}

#FilterSidebar {
    background-color: #2A1F33;
    border-right: 1px solid #4A3A54;
}

#FilterSidebarScroll,
#FilterSidebarScroll > QWidget#qt_scrollarea_viewport,
#FilterSidebarContent {
    background-color: #2A1F33;
    border: none;
}

#FilterSidebarHeading {
    font-size: 11px;
    font-weight: 800;
    color: #C7B9D4;
    letter-spacing: 1.2px;
    padding-top: 6px;
    background: transparent;
}

#FilterSidebarInput {
    background-color: #2E2238;
    border: 1px solid #4A3A54;
    border-radius: 10px;
    padding: 9px 12px;
    font-size: 13px;
    color: #EDE6F2;
    min-height: 18px;
}
#FilterSidebarInput:focus {
    border: 2px solid #7B8BE0;
    padding: 8px 11px;
    background-color: #352543;
}
#FilterSidebarInput::drop-down { border: none; padding-right: 8px; }

#FilterSidebarRadio,
#FilterSidebarCheck {
    font-size: 13px;
    color: #EDE6F2;
    background: transparent;
    padding: 3px 0;
    spacing: 8px;
}
#FilterSidebarRadio::indicator,
#FilterSidebarCheck::indicator {
    width: 16px; height: 16px;
    border: 1px solid #4A3A54;
    background-color: #2E2238;
}
#FilterSidebarRadio::indicator { border-radius: 8px; }
#FilterSidebarCheck::indicator { border-radius: 4px; }
#FilterSidebarRadio::indicator:hover,
#FilterSidebarCheck::indicator:hover {
    border-color: #7B8BE0;
}
#FilterSidebarRadio::indicator:checked,
#FilterSidebarCheck::indicator:checked {
    background-color: #B39CDB;
    border-color: #B39CDB;
}

#FilterSidebarClear {
    background-color: #B39CDB;
    color: #1E1626;
    border: none;
    padding: 12px 16px;
    font-size: 13px;
    font-weight: 700;
    margin: 12px;
    border-radius: 10px;
}
#FilterSidebarClear:hover { background-color: #7B8BE0; }

#EventCardBody { background: transparent; border: none; }

#EventClusterChip {
    background-color: #7B8BE0;
    color: #1E1626;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.4px;
    padding: 4px 10px;
    border-radius: 10px;
    max-width: 220px;
}

#EventCardMetaIcon {
    font-size: 10px;
    font-weight: 800;
    color: #4A3A54;
    letter-spacing: 1px;
}

#EventCard {
    background-color: #2E2238;
    border: 1px solid #4A3A54;
    border-radius: 16px;
}
#EventCard:hover { border-color: #7B8BE0; }

#EventCardMoxie {
    background-color: #2E2238;
    border: 1px solid #7B8BE0;
    border-radius: 16px;
}
#EventCardMoxie:hover { border-color: #B39CDB; }

#EventThumb {
    background-color: #251A2E;
    color: #9C8EA9;
    font-size: 12px;
    border-top-left-radius: 16px;
    border-top-right-radius: 16px;
}

#EventTitle { font-size: 16px; font-weight: 800; color: #EDE6F2; }
#EventTitleList { font-size: 18px; font-weight: 800; color: #EDE6F2; }
#EventOrg { font-size: 12px; color: #9C8EA9; }
#EventDescription { font-size: 12px; color: #C7B9D4; }
#EventMetaValue { font-size: 12px; color: #EDE6F2; font-weight: 600; }
#EventMetaKey {
    font-size: 10px; color: #4A3A54;
    font-weight: 700; letter-spacing: 1px;
}

#EventDetailsBtn {
    background-color: #7B8BE0; color: #1E1626;
    border: none; border-radius: 10px;
    padding: 10px 16px; font-size: 12px; font-weight: 700;
}
#EventDetailsBtn:hover  { background-color: #B39CDB; }
#EventDetailsBtn:pressed{ background-color: #B39CDB; }

#EventRsvpBtn {
    background-color: #B39CDB; color: #1E1626;
    border: none; border-radius: 10px;
    padding: 10px 16px; font-size: 12px; font-weight: 700;
}
#EventRsvpBtn:hover { background-color: #7B8BE0; }
#EventRsvpBtn:disabled { background-color: #4A3A54; color: #2E2238; }

#EventLinkBtn {
    background-color: transparent; color: #B39CDB;
    border: 1px solid #4A3A54; border-radius: 10px;
    padding: 10px 16px; font-size: 12px; font-weight: 700;
}
#EventLinkBtn:hover { border-color: #7B8BE0; color: #7B8BE0; }
#EventLinkBtn:disabled { color: #4A3A54; }

#EventBookmarkBtn {
    background-color: transparent; color: #4A3A54;
    border: 1px solid #4A3A54; border-radius: 10px;
    font-size: 18px; padding: 0;
}
#EventBookmarkBtn:hover { color: #7B8BE0; border-color: #7B8BE0; }
#EventBookmarkBtnOn {
    background-color: #7B8BE0; color: #1E1626;
    border: none; border-radius: 10px; font-size: 18px; padding: 0;
}

#EventSourceMoxie {
    background-color: #B39CDB; color: #1E1626;
    font-size: 10px; font-weight: 700;
    padding: 4px 10px; border-radius: 10px;
}
#EventSourceExternal {
    background-color: rgba(46, 34, 56, 0.9);
    color: #C7B9D4;
    border: 1px solid #4A3A54;
    font-size: 10px; font-weight: 700;
    padding: 3px 9px; border-radius: 10px;
}

#VolunteerResultsCount {
    font-size: 12px; color: #9C8EA9; letter-spacing: 0.4px;
}
/* ==========================================================================
   HERO — editorial split-panel
   ========================================================================== */
#HeroSection {
    background-color: #1E1626;
}

#HeroLeftPanel {
    background-color: #2A1F33;
}

#HeroRightPanel {
    background-color: #1E1626;
}

#HeroBottomBar {
    background-color: #B39CDB;
}

#HeroWordmark {
    padding: 0;
    margin: 0;
}

#HeroHeadline {
    font-family: "Playfair Display", "Georgia", "Times New Roman", serif;
    font-size: 44px;
    font-weight: 700;
    color: #EDE6F2;
    line-height: 1.15em;
}

#HeroSub {
    font-size: 15px;
    color: #C7B9D4;
    line-height: 1.55em;
}

#HeroPhoto {
    background-color: #2E2238;
    border: none;
}